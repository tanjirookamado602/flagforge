# FlagForge Environment Configuration
# Copy this to .env and adjust if needed

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=flagsmith_secure_password
POSTGRES_DB=flagsmith
POSTGRES_PORT=5432

# Flagsmith Core Settings
FLAGSMITH_PORT=8000
FLAGSMITH_DOMAIN=localhost:8000
DJANGO_SECRET_KEY=flagforge-super-secret-key-change-in-production-12345
ENVIRONMENT=local
DJANGO_ALLOWED_HOSTS=*
ENABLE_TELEMETRY=false
PREVENT_SIGNUP=false

# Task Processor & Analytics
TASK_RUN_METHOD=TASK_PROCESSOR
USE_POSTGRES_FOR_ANALYTICS=true

# Initial Admin Bootstrap (Optional automated provisioning)
ALLOW_ADMIN_INITIATION_VIA_CLI=true
ADMIN_EMAIL=admin@flagforge.local
ORGANISATION_NAME=FlagForge
PROJECT_NAME=flagforge-demo
